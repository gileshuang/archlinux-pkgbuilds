package() {
    echo "  -> Extracting the data.tar.xz..."
    bsdtar -xf data.tar.xz -C "${pkgdir}/"

    echo "  -> Apply patch from aosc-os-abbs"
    echo "DEBUG: pkgdir: ${pkgdir}"
    cd "${pkgdir}/usr/src/zx-${pkgver}"
    patch -p1 < ${srcdir}/0001-fix-kbuild-replace-EXTRA_CFLAGS-with-ccflags-y.patch
    patch -p1 < ${srcdir}/0002-chore-dkms-remove-useless-variables.patch
    patch -p1 < ${srcdir}/0003-fix-kernel-6.15.patch
    patch -p1 < ${srcdir}/0004-fix-kernel-6.16.patch
    patch -p1 < ${srcdir}/0005-fix-kernel-6.17.patch
    patch -p1 < ${srcdir}/0006-fix-kernel-6.18.patch
    patch -p1 < ${srcdir}/0007-chore-import-.gitignore-from-loonggpu-kernel-dkms.patch
    patch -p1 < ${srcdir}/0008-refactor-NFC-rename-zxfb_create-to-zx_fbdev_probe.patch
    patch -p1 < ${srcdir}/0009-fix-run-DRM-default-client-setup-on-Linux-6.15.patch
    patch -p1 < ${srcdir}/0010-fix-adapt-for-shmem_file_setup-parameter-change-in-L.patch
    patch -p1 < ${srcdir}/0011-fix-remove-zx_drm_last_close-on-Linux-6.12.patch
    patch -p1 < ${srcdir}/0012-fix-adapt-for-drm_fb_helper_alloc_info-removal-in-Li.patch
    patch -p1 < ${srcdir}/0013-refactor-make-the-fbdev-ptr-in-zx_card_t-typed.patch
    patch -p1 < ${srcdir}/0014-refactor-Remove-load-callback-from-kms_driver.patch
    patch -p1 < ${srcdir}/0015-refactor-make-to_zx_fbdev-use-the-helper-ptr-stored-.patch
    patch -p1 < ${srcdir}/0016-refactor-Suspend-resume-fbdev-emulation-via-client-i.patch
    patch -p1 < ${srcdir}/0017-refactor-use-helper-instead-of-fbdev-helper-in-zx_fb.patch
    patch -p1 < ${srcdir}/0018-fix-take-out-embedded-fb_helper-in-zx_fbdev-with-Lin.patch
    cd -

    echo "  -> Installing..."
    #rmdir ${pkgdir}/usr/local/bin
    rm -rf ${pkgdir}/usr/share/initramfs-tools
    install -Dm644 -T mkinitcpio.drop-in.conf "${pkgdir}/etc/mkinitcpio.conf.d/zhaoxin.conf"
    install -Dm644 -T modprobe.d_zx_gfx.conf "${pkgdir}/etc/modprobe.d/zx_gfx.conf"
    install -Dm644 -T egl_vendor.d_10_zx.json "${pkgdir}/usr/share/glvnd/egl_vendor.d/10_zx.json"
    install -Dm644 -T xorg.conf.d_10-zxgpu.conf "${pkgdir}/usr/share/X11/xorg.conf.d/10-zxgpu.conf"
    install -Dm755 -T profile.d_zhaoxin-glsl.sh "${pkgdir}/etc/profile.d/zhaoxin-glsl.sh"

    install ${pkgdir}/usr/lib/x86_64-linux-gnu/libEGL_zx.so.0.0.0 ${pkgdir}/usr/lib/libEGL_zx.so.0
    install ${pkgdir}/usr/lib/x86_64-linux-gnu/libglapi_zx.so.0.0.0 ${pkgdir}/usr/lib/libglapi_zx.so.0
    install ${pkgdir}/usr/lib/x86_64-linux-gnu/libGLX_zx.so.0.0.0 ${pkgdir}/usr/lib/libGLX_zx.so.0
    install ${pkgdir}/usr/lib/x86_64-linux-gnu/libkeinterface_zx.so.0.0.0 ${pkgdir}/usr/lib/libkeinterface_zx.so.0
    install -t ${pkgdir}/usr/lib ${pkgdir}/usr/lib/x86_64-linux-gnu/libvdpau_zx.so

    install -Dt ${pkgdir}/usr/lib/dri ${pkgdir}/usr/lib/x86_64-linux-gnu/dri/zx_drv_video.so
    install -Dt ${pkgdir}/usr/lib/dri ${pkgdir}/usr/lib/x86_64-linux-gnu/dri/zx_vndri.so
    install -m644 -Dt ${pkgdir}/usr/lib/dri ${pkgdir}/usr/lib/x86_64-linux-gnu/dri/ZXEApp.cfg

    install -Dt ${pkgdir}/usr/lib/gbm ${pkgdir}/usr/lib/x86_64-linux-gnu/gbm/zx_gbm.so

    rm -rfv "${pkgdir}/usr/lib/x86_64-linux-gnu/"
}
