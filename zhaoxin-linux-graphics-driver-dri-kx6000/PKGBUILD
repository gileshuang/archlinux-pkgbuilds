_pkgname=zhaoxin-linux-graphics-driver-dri-kx6000
pkgname=${_pkgname}-dkms
pkgver=21.00.91
pkgrel=1
url="https://www.zhaoxin.com"
pkgdesc="Graphics driver for Zhaoxin C-960 (KX-6000/6900 series). \
    Fixed by https://handbook.aaether.net/pages/zhaoxin-kx-6000-igpu-driver.html"
license=('custom:zhaoxin')
arch=('x86_64')
_patch_url_prefix="https://github.com/AOSC-Dev/aosc-os-abbs/raw/refs/heads/stable/runtime-display/zhaoxin-linux-graphics-driver-dri/autobuild/module-patches"
conflicts=("${_pkgname}")
provides=("${_pkgname}")
depends=('glibc' 'dkms' 'libdrm' 'libglvnd' 'mesa' 'libxcb' 'wayland')
optdepends=('linux-headers: Build the module for Arch kernel'
            'linux-lts-headers: Build the module for LTS Arch kernel')
options=(!debug !lto)

source=(
    # https://www.zhaoxin.com/qdxz.aspx?nid=31&typeid=156
    "zhaoxin-linux-graphics-driver-dri-glvnd_${pkgver}_amd64.deb"
    "mkinitcpio.drop-in.conf"
    "modprobe.d_zx_gfx.conf"
    "egl_vendor.d_10_zx.json"
    "xorg.conf.d_10-zxgpu.conf"
    "profile.d_zhaoxin-glsl.sh"
    "${_patch_url_prefix}/0001-fix-kbuild-replace-EXTRA_CFLAGS-with-ccflags-y.patch"
    "${_patch_url_prefix}/0002-chore-dkms-remove-useless-variables.patch"
    "${_patch_url_prefix}/0003-fix-kernel-6.15.patch"
    "${_patch_url_prefix}/0004-fix-kernel-6.16.patch"
    "${_patch_url_prefix}/0005-fix-kernel-6.17.patch"
    "${_patch_url_prefix}/0006-fix-kernel-6.18.patch"
    "${_patch_url_prefix}/0007-chore-import-.gitignore-from-loonggpu-kernel-dkms.patch"
    "${_patch_url_prefix}/0008-refactor-NFC-rename-zxfb_create-to-zx_fbdev_probe.patch"
    "${_patch_url_prefix}/0009-fix-run-DRM-default-client-setup-on-Linux-6.15.patch"
    "${_patch_url_prefix}/0010-fix-adapt-for-shmem_file_setup-parameter-change-in-L.patch"
    "${_patch_url_prefix}/0011-fix-remove-zx_drm_last_close-on-Linux-6.12.patch"
    "${_patch_url_prefix}/0012-fix-adapt-for-drm_fb_helper_alloc_info-removal-in-Li.patch"
    "${_patch_url_prefix}/0013-refactor-make-the-fbdev-ptr-in-zx_card_t-typed.patch"
    "${_patch_url_prefix}/0014-refactor-Remove-load-callback-from-kms_driver.patch"
    "${_patch_url_prefix}/0015-refactor-make-to_zx_fbdev-use-the-helper-ptr-stored-.patch"
    "${_patch_url_prefix}/0016-refactor-Suspend-resume-fbdev-emulation-via-client-i.patch"
    "${_patch_url_prefix}/0017-refactor-use-helper-instead-of-fbdev-helper-in-zx_fb.patch"
    "${_patch_url_prefix}/0018-fix-take-out-embedded-fb_helper-in-zx_fbdev-with-Lin.patch"
)
